# ===================================================
# Clip Capture - Configurações do Sistema
# ===================================================

# Identificação do Campo
FIELD_ID=campo-1
DEVICE_TOKEN=clip-capture-secret-demo-token

# URLs das Câmeras RTSP Reais (substitua pelo IP/login das suas câmeras)
RTSP_CAM_1=rtsp://admin:senha@192.168.1.101:554/stream1
RTSP_CAM_2=rtsp://admin:senha@192.168.1.102:554/stream1
RTSP_CAM_3=rtsp://admin:senha@192.168.1.103:554/stream1

# Armazenamento em Nuvem S3 (Opcional - se vazio, salva em disco local /app/storage)
STORAGE_DRIVER=local
# STORAGE_DRIVER=s3
# S3_BUCKET=meu-bucket-de-lances
# AWS_ACCESS_KEY_ID=sua_chave_aws
# AWS_SECRET_ACCESS_KEY=seu_segredo_aws
# AWS_REGION=us-east-1

# URL pública para links de compartilhamento (ex: https://replay.seusite.com)
APP_BASE_URL=http://localhost:3000
